      "name": "Redator Linkedin"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=FORMATO ESCOLHIDO: {{ $('Basic LLM Chain').item.json.output.instagram.formato }}\n\nJUSRIFICATIVA: {{ $('Basic LLM Chain').item.json.output.instagram.justificativa }}\n\nDIREÇÃO DO DIRETOR: \n- ESTRATEGIA GERAL: {{ $('Basic LLM Chain').item.json.output.estrategia_geral }}\n\n- ÂNGULO UNICO: {{ $('Basic LLM Chain').item.json.output.angulo_unico }}\n\n- TOM GERAL: {{ $('Basic LLM Chain').item.json.output.tom_geral }}\n\nINSIGHTS: {{ $('Summarization Chain').item.json.output.text }}\n\nTEMA: {{ $('Information Extractor').item.json.output.tema }}\n\nPUBLICO_ALVO: {{ $('Information Extractor').item.json.output.publico_alvo }}",
        "hasOutputParser": true,
        "needsFallback": true,
        "messages": {
          "messageValues": [
            {
              "message": "=Você é um social media para Instagram. O Diretor escolheu o formato. Adapte: SE \"carrossel\": - 6-8 slides em markdown - Slide 1: capa (max 6 palavras) + subtítulo - Slides 2-7: didático (titulo curto + corpo max 30 palavras) - Slide 8: CTA - Cada slide: ## Slide N: Título\\nCorpo do slide - Legenda do post no fim (~150 palavras + hashtags) SE \"stories\": - 5-8 cards em markdown - Cada card: ## Story N - [tipo]\\nTexto curto e visual - Tipos: enquete, caixa de pergunta, contagem regressiva, texto puro, sticker de música - Cada card tem máximo 15 palavras - Mais informal que carrossel SE \"post_estatico\": - 1 imagem + legenda - Bloco 1: DESCRICAO DA IMAGEM (o que aparece, cores, mood) - Bloco 2: LEGENDA (~250 palavras com hashtags) - Bloco 3: CTA + comentário pin Retorne JSON estrito."
            }
          ]
        },
        "batching": {}
      },
