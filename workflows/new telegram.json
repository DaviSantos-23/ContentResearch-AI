        "text": "=FORMATO ESCOLHIDO: {{ $('Basic LLM Chain').item.json.output.video.formato }}\n\nJUSRIFICATIVA: {{ $('Basic LLM Chain').item.json.output.video.justificativa }}\n\nDIREÇÃO DO DIRETOR: \n- ESTRATEGIA GERAL: {{ $('Basic LLM Chain').item.json.output.estrategia_geral }}\n\n- ÂNGULO UNICO: {{ $('Basic LLM Chain').item.json.output.angulo_unico }}\n\n- TOM GERAL: {{ $('Basic LLM Chain').item.json.output.tom_geral }}\n\nINSIGHTS: {{ $('Summarization Chain').item.json.output.text }}\n\nTEMA: {{ $('Information Extractor').item.json.output.tema }}\n\nPUBLICO_ALVO: {{ $('Information Extractor').item.json.output.publico_alvo }}",
        "hasOutputParser": true,
